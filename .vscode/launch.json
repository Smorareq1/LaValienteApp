{
  // El backend se elige en compilacion (Env.apiBaseUrl es String.fromEnvironment).
  // La direccion vive en dev.json / prod.json, que NO se versionan: este
  // repositorio es publico. Copia los .example la primera vez.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (backend de dev.json)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file", "dev.json"]
    },
    {
      "name": "App (PRODUCCION - Railway)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Corre contra el backend real, con datos reales. Util para reproducir
      // algo que solo pasa en produccion; no para trabajar el dia a dia.
      "args": ["--dart-define-from-file", "prod.json"]
    },
    {
      "name": "App (emulador Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // 10.0.2.2 es el localhost del host visto desde el emulador de Android.
      "args": ["--dart-define", "API_BASE_URL=http://10.0.2.2:8000"]
    },
    {
      "name": "App (backend en esta maquina)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define", "API_BASE_URL=http://localhost:8000"]
    }
  ]
}
